{
  "name": "api-server-v6",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch  src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:dev": "tsx src/database/migrate.ts",
    "migrate:prod": "node dist/database/migrate.js",
