    "docker:build": "docker build -t api .",
    "docker:save": "docker save -o production/api.tar api"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/bcrypt": "^6.0.0",
